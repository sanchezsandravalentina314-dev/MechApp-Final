# Configuración del Backend MechApp (FastAPI)
PORT=8000
HOST=0.0.0.0

# Base de datos (PostgreSQL o SQLite local)
DATABASE_URL=sqlite:///./mechapp.db
# Para PostgreSQL: postgresql://postgres:postgres@localhost:5432/mechapp

# Seguridad JWT
JWT_SECRET_KEY=mechapp_super_secret_jwt_key_2026_tejo_nacional_colombia
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Clave Secreta de Cloudflare Turnstile / reCAPTCHA
# Clave de prueba de Cloudflare Turnstile oficial (1x0000000000000000000000000000000AA pasa siempre)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Servicio de Correo Seguro (SMTP para recuperación de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@mechapp.com
SMTP_PASSWORD=app_password_segura
SMTP_FROM=MechApp Seguridad <notificaciones@mechapp.com>
FRONTEND_URL=http://localhost:5173
