# MechApp Backend - Variables de Entorno
# Copia este archivo como .env y llena los valores reales

# Base de datos
DATABASE_URL=postgresql://TU_USUARIO:TU_CONTRASEÑA@localhost:5433/MechApp

# Seguridad JWT — OBLIGATORIO. Genera una clave con:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_64_BYTES

# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Modo debug: True solo en desarrollo local, NUNCA en producción
DEBUG=False

# ── Configuración de Email (Resend) ──────────────────────────────
# Regístrate en https://resend.com (gratis, 100 emails/día)
# Ve a API Keys → Create API Key → pega el valor aquí
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_NOMBRE=MechApp - Tejo Colombiano
# Mientras no tengas dominio propio, usa el remitente de prueba de Resend:
EMAIL_ORIGEN=onboarding@resend.dev
